{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "StatefulSet",
      "metadata": {
        "name": "qdrant",
        "namespace": "framework-intelligence",
        "labels": {
          "app.kubernetes.io/name": "qdrant",
          "app.kubernetes.io/component": "vector-store"
        }
      },
      "spec": {
        "serviceName": "qdrant",
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "qdrant",
            "app.kubernetes.io/component": "vector-store"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "qdrant",
              "app.kubernetes.io/component": "vector-store"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "containers": [
              {
                "name": "qdrant",
                "image": "qdrant/qdrant:v1.12.5",
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 6333
                  },
                  {
                    "name": "grpc",
                    "containerPort": 6334
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/healthz",
                    "port": "http"
                  },
                  "initialDelaySeconds": 5,
                  "periodSeconds": 10
                },
                "resources": {
                  "requests": {
                    "cpu": "250m",
                    "memory": "512Mi"
                  },
                  "limits": {
                    "cpu": "2",
                    "memory": "2Gi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  },
                  "seccompProfile": {
                    "type": "RuntimeDefault"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "data",
                    "mountPath": "/qdrant/storage"
                  }
                ]
              }
            ],
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 1000,
              "runAsGroup": 1000,
              "fsGroup": 1000,
              "fsGroupChangePolicy": "OnRootMismatch",
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            }
          }
        },
        "volumeClaimTemplates": [
          {
            "metadata": {
              "name": "data"
            },
            "spec": {
              "accessModes": [
                "ReadWriteOnce"
              ],
              "resources": {
                "requests": {
                  "storage": "20Gi"
                }
              }
            }
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "qdrant",
        "namespace": "framework-intelligence",
        "labels": {
          "app.kubernetes.io/name": "qdrant",
          "app.kubernetes.io/component": "vector-store"
        }
      },
      "spec": {
        "type": "ClusterIP",
        "selector": {
          "app.kubernetes.io/name": "qdrant",
          "app.kubernetes.io/component": "vector-store"
        },
        "ports": [
          {
            "name": "http",
            "port": 6333,
            "targetPort": "http"
          },
          {
            "name": "grpc",
            "port": 6334,
            "targetPort": "grpc"
          }
        ]
      }
    }
  ]
}
