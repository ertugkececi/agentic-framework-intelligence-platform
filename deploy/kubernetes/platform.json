{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "agentic-platform",
        "namespace": "framework-intelligence",
        "labels": {
          "app.kubernetes.io/name": "agentic-platform",
          "app.kubernetes.io/component": "api"
        }
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "agentic-platform",
            "app.kubernetes.io/component": "api"
          }
        },
        "strategy": {
          "type": "Recreate"
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "agentic-platform",
              "app.kubernetes.io/component": "api"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 10001,
              "runAsGroup": 10001,
              "fsGroup": 10001,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "api",
                "image": "agentic-framework-intelligence-platform:0.1.0",
                "imagePullPolicy": "IfNotPresent",
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 8000
                  }
                ],
                "envFrom": [
                  {
                    "configMapRef": {
                      "name": "agentic-platform-config"
                    }
                  }
                ],
                "env": [
                  {
                    "name": "API_KEY",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "agentic-platform-secrets",
                        "key": "api-key"
                      }
                    }
                  },
                  {
                    "name": "POSTGRES_DSN",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "agentic-platform-secrets",
                        "key": "postgres-dsn"
                      }
                    }
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/health",
                    "port": "http"
                  },
                  "initialDelaySeconds": 3,
                  "periodSeconds": 10
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/health",
                    "port": "http"
                  },
                  "initialDelaySeconds": 10,
                  "periodSeconds": 20
                },
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "256Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "1Gi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  },
                  "readOnlyRootFilesystem": true
                },
                "volumeMounts": [
                  {
                    "name": "workspace",
                    "mountPath": "/workspace"
                  },
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "workspace",
                "persistentVolumeClaim": {
                  "claimName": "agentic-platform-workspace"
                }
              },
              {
                "name": "tmp",
                "emptyDir": {}
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "agentic-platform",
        "namespace": "framework-intelligence",
        "labels": {
          "app.kubernetes.io/name": "agentic-platform",
          "app.kubernetes.io/component": "api"
        }
      },
      "spec": {
        "type": "ClusterIP",
        "selector": {
          "app.kubernetes.io/name": "agentic-platform",
          "app.kubernetes.io/component": "api"
        },
        "ports": [
          {
            "name": "http",
            "port": 8000,
            "targetPort": "http"
          }
        ]
      }
    }
  ]
}
