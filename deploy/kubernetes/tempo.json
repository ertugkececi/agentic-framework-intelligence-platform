{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "tempo-config",
        "namespace": "framework-intelligence"
      },
      "data": {
        "tempo.yaml": "server:\n  http_listen_port: 3200\ndistributor:\n  receivers:\n    otlp:\n      protocols:\n        grpc:\n          endpoint: 0.0.0.0:4317\ningester:\n  max_block_duration: 5m\ncompactor:\n  compaction:\n    block_retention: 336h\nstorage:\n  trace:\n    backend: local\n    wal:\n      path: /var/tempo/wal\n    local:\n      path: /var/tempo/blocks\n"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "StatefulSet",
      "metadata": {
        "name": "tempo",
        "namespace": "framework-intelligence",
        "labels": {
          "app.kubernetes.io/name": "tempo",
          "app.kubernetes.io/component": "traces"
        }
      },
      "spec": {
        "serviceName": "tempo",
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "tempo",
            "app.kubernetes.io/component": "traces"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "tempo",
              "app.kubernetes.io/component": "traces"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 10001,
              "runAsGroup": 10001,
              "fsGroup": 10001,
              "fsGroupChangePolicy": "OnRootMismatch",
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "tempo",
                "image": "grafana/tempo:2.6.1@sha256:ef4384fce6e8ad22b95b243d8fc165628cda655376fd50e7850536ad89d71d50",
                "args": [
                  "-config.file=/etc/tempo/tempo.yaml"
                ],
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 3200
                  },
                  {
                    "name": "otlp-grpc",
                    "containerPort": 4317
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/ready",
                    "port": "http"
                  },
                  "initialDelaySeconds": 5,
                  "periodSeconds": 10
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/ready",
                    "port": "http"
                  },
                  "initialDelaySeconds": 15,
                  "periodSeconds": 20
                },
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "256Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "1Gi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "volumeMounts": [
                  {
                    "name": "config",
                    "mountPath": "/etc/tempo",
                    "readOnly": true
                  },
                  {
                    "name": "data",
                    "mountPath": "/var/tempo"
                  },
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "config",
                "configMap": {
                  "name": "tempo-config"
                }
              },
              {
                "name": "tmp",
                "emptyDir": {}
              }
            ]
          }
        },
        "volumeClaimTemplates": [
          {
            "metadata": {
              "name": "data"
            },
            "spec": {
              "accessModes": [
                "ReadWriteOnce"
              ],
              "resources": {
                "requests": {
                  "storage": "20Gi"
                }
              }
            }
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "tempo",
        "namespace": "framework-intelligence",
        "labels": {
          "app.kubernetes.io/name": "tempo",
          "app.kubernetes.io/component": "traces"
        }
      },
      "spec": {
        "type": "ClusterIP",
        "selector": {
          "app.kubernetes.io/name": "tempo",
          "app.kubernetes.io/component": "traces"
        },
        "ports": [
          {
            "name": "http",
            "port": 3200,
            "targetPort": "http"
          },
          {
            "name": "otlp-grpc",
            "port": 4317,
            "targetPort": "otlp-grpc"
          }
        ]
      }
    }
  ]
}
