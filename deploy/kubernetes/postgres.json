{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "StatefulSet",
      "metadata": {
        "name": "postgres",
        "namespace": "framework-intelligence",
        "labels": {
          "app.kubernetes.io/name": "postgres",
          "app.kubernetes.io/component": "structured-store"
        }
      },
      "spec": {
        "serviceName": "postgres",
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "postgres",
            "app.kubernetes.io/component": "structured-store"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "postgres",
              "app.kubernetes.io/component": "structured-store"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "containers": [
              {
                "name": "postgres",
                "image": "postgres:16.6-bookworm",
                "ports": [
                  {
                    "name": "postgres",
                    "containerPort": 5432
                  }
                ],
                "env": [
                  {
                    "name": "POSTGRES_DB",
                    "value": "framework_intelligence"
                  },
                  {
                    "name": "POSTGRES_USER",
                    "value": "framework_intelligence"
                  },
                  {
                    "name": "POSTGRES_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "agentic-platform-secrets",
                        "key": "postgres-password"
                      }
                    }
                  }
                ],
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "pg_isready",
                      "-U",
                      "framework_intelligence",
                      "-d",
                      "framework_intelligence"
                    ]
                  },
                  "initialDelaySeconds": 5,
                  "periodSeconds": 10
                },
                "resources": {
                  "requests": {
                    "cpu": "250m",
                    "memory": "512Mi"
                  },
                  "limits": {
                    "cpu": "2",
                    "memory": "2Gi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  },
                  "seccompProfile": {
                    "type": "RuntimeDefault"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "data",
                    "mountPath": "/var/lib/postgresql/data"
                  }
                ]
              }
            ],
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 999,
              "runAsGroup": 999,
              "fsGroup": 999,
              "fsGroupChangePolicy": "OnRootMismatch",
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            }
          }
        },
        "volumeClaimTemplates": [
          {
            "metadata": {
              "name": "data"
            },
            "spec": {
              "accessModes": [
                "ReadWriteOnce"
              ],
              "resources": {
                "requests": {
                  "storage": "20Gi"
                }
              }
            }
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "postgres",
        "namespace": "framework-intelligence",
        "labels": {
          "app.kubernetes.io/name": "postgres",
          "app.kubernetes.io/component": "structured-store"
        }
      },
      "spec": {
        "type": "ClusterIP",
        "clusterIP": "None",
        "selector": {
          "app.kubernetes.io/name": "postgres",
          "app.kubernetes.io/component": "structured-store"
        },
        "ports": [
          {
            "name": "postgres",
            "port": 5432,
            "targetPort": "postgres"
          }
        ]
      }
    }
  ]
}
